{
  "name": "lumo-platform",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.19"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test --config playwright.next.config.ts",
    "test:e2e:public": "playwright test --config playwright.next.config.ts --project=chrome-public --project=webkit-public",
    "test:e2e:authenticated": "playwright test --config playwright.next.config.ts --project=chrome-authenticated",
    "test:pricing": "node scripts/test-pricing-engine.mjs",
    "portfolio:cms:dev": "vite --config admin/portfolio/vite.config.ts --host 0.0.0.0",
    "portfolio:cms:build": "vite build --config admin/portfolio/vite.config.ts",
    "portfolio:cms:lint": "tsc -p admin/portfolio/tsconfig.json --noEmit",
    "portfolio:cms:test": "vitest run --config admin/portfolio/vitest.config.ts",
    "portfolio:cms:e2e": "playwright test --config admin/portfolio/playwright.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.109.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-three/fiber": "9.6.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@types/dompurify": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dompurify": "^3.4.12",
    "framer-motion": "12.42.2",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "ogl": "^1.0.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "three": "0.180.0",
    "typescript": "6.0.3",
    "uuid": "^14.0.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  }
}
